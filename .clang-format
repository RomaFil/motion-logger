# Стиль коду motion_logger: Linux kernel style (лекція Ajax Code Style, 17.09.2026).
# Версія форматера зафіксована: clang-format 23.1.1 (pip install clang-format==23.1.1).
# Інша major-версія може форматувати інакше, тому перевіряй тією самою.
BasedOnStyle: LLVM
IndentWidth: 8
TabWidth: 8
UseTab: Always
ColumnLimit: 100
BreakBeforeBraces: Linux
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
IndentCaseLabels: false
SortIncludes: true
PointerAlignment: Right
