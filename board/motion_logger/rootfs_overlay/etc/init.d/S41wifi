#!/bin/sh
# Wi-Fi на wlan0: wpa_supplicant + DHCP (BusyBox init викликає S* скрипти з аргументом start / stop).
# Мережі й паролі НЕ в образі і НЕ в git: їх читаємо з /boot/wifi.txt (FAT-розділ microSD, його видно з
# Windows). Змінити мережу = відредагувати цей файл на картці (або `vi /boot/wifi.txt` на платі) і
# виконати `/etc/init.d/S41wifi restart`. Формат файлу: board/motion_logger/wifi.txt.example.
# Пишемо на POSIX sh: на платі це BusyBox ash.
NAME=wifi
IFACE=wlan0
BOOT_DEV=/dev/mmcblk0p1
BOOT_DIR=/boot
CONF_SRC=$BOOT_DIR/wifi.txt
# Робочий конфіг wpa_supplicant лежить у tmpfs (/run): пароль не потрапляє у файлову систему образу.
CONF=/run/wpa_supplicant.conf
WPA_PID=/run/wpa_supplicant.pid
WPA_LOG=/run/wpa_supplicant.log
DHCP_PID=/run/udhcpc.$IFACE.pid
# Скільки секунд чекати появи wlan0 після завантаження модуля brcmfmac (прошивка вантажиться ~2 с).
IFACE_TIMEOUT=20
HOSTNAME_DHCP=motion-logger
# Діагностика без консолі: через DEBUG_DELAYS секунд після старту пишемо стан Wi-Fi у /boot/wifi-debug.log
# (файл видно з Windows, коли картку вставлено в ПК). Вимкнути: DEBUG=0 у wifi.txt.
DEBUG_LOG=$BOOT_DIR/wifi-debug.log
DEBUG_DELAYS="25 90"

# Значення ключа з wifi.txt (перший збіг, без CR від Windows-редактора).
key() {
	sed -n "s/^$1=//p" "$CONF_SRC" 2>/dev/null | head -n 1 | tr -d '\r'
}

mount_boot() {
	mountpoint -q "$BOOT_DIR" && return 0
	mkdir -p "$BOOT_DIR"
	# sync: файл правиться на платі вручну, не хочемо втратити зміну при вимкненні живлення.
	mount -t vfat -o rw,noatime,sync "$BOOT_DEV" "$BOOT_DIR"
}

# wifi.txt -> /run/wpa_supplicant.conf. Мереж до чотирьох: SSID, SSID2, SSID3, SSID4 (+ PSK, PSK2, ...);
# wpa_supplicant сам обирає ту, що в ефірі. Порожній PSK = відкрита мережа.
make_conf() {
	country=$(key COUNTRY)
	umask 077
	{
		echo "ctrl_interface=/run/wpa_supplicant"
		echo "country=${country:-UA}"
		for n in "" 2 3 4; do
			ssid=$(key "SSID$n")
			[ -n "$ssid" ] || continue
			psk=$(key "PSK$n")
			echo "network={"
			echo "	ssid=\"$ssid\""
			echo "	scan_ssid=1"
			if [ -n "$psk" ]; then
				echo "	psk=\"$psk\""
			else
				echo "	key_mgmt=NONE"
			fi
			echo "}"
		done
	} >"$CONF"
	grep -q '^network=' "$CONF"
}

# Один знімок стану для wifi-debug.log; викликається з фонового підпроцесу.
debug_snapshot() {
	echo "=== $(date) | uptime: $(cut -d' ' -f1 /proc/uptime) s | $1"
	echo "--- net:"; ls /sys/class/net
	echo "--- wlan0 mac: $(cat /sys/class/net/$IFACE/address 2>/dev/null)"
	echo "--- lsmod (net/wifi):"; lsmod | grep -E 'brcm|cfg80211|rfkill|mmc|sdhci'
	echo "--- dmesg (wifi):"; dmesg | grep -iE 'brcm|wlan|mmc[0-9]|sdio|firmware|cfg80211|regulatory|wifi' | tail -n 40
	echo "--- dmesg (tail):"; dmesg | tail -n 15
	echo "--- processes (all):"; ps
	echo "--- binaries:"; ls -l /usr/sbin/wpa_supplicant /usr/sbin/wpa_cli 2>&1; wpa_supplicant -v 2>&1 | head -n 2
	echo "--- /run:"; ls -l /run /run/wpa_supplicant 2>&1
	echo "--- wpa conf (psk hidden):"; sed 's/psk=.*/psk=<hidden>/' "$CONF" 2>&1
	echo "--- wpa_supplicant.log (tail):"; tail -n 60 "$WPA_LOG" 2>&1
	echo "--- ip addr:"; ip addr show "$IFACE" 2>&1
	echo "--- wpa_cli status:"; wpa_cli -i "$IFACE" status 2>&1
	echo "--- iw power_save / link:"; iw dev "$IFACE" get power_save 2>&1; iw dev "$IFACE" link 2>&1
	echo "--- wpa_cli signal_poll:"; wpa_cli -i "$IFACE" signal_poll 2>&1
	echo "--- wpa_cli scan_results:"; wpa_cli -i "$IFACE" scan_results 2>&1 | head -n 25
	echo "--- syslog (wpa/udhcpc):"; grep -E 'wpa_supplicant|udhcpc|wifi' /var/log/messages 2>/dev/null | tail -n 25
	echo
}

debug_later() {
	prev=0
	for t in $DEBUG_DELAYS; do
		sleep $((t - prev))
		prev=$t
		debug_snapshot "після ${t} с" >>"$DEBUG_LOG" 2>&1
		sync
	done
}

# brcmfmac вмикає power save сам (dmesg: "power save enabled"). Плата, що дрімає між кадрами, не відповідає на
# ARP і з ПК "зникає", хоча DHCP-оренду має. Вимикаємо кілька разів: налаштування застосовується після асоціації.
wifi_power_save_off() {
	for t in 5 10 20 40; do
		sleep "$t"
		iw dev "$IFACE" set power_save off 2>/dev/null
	done
}

is_running() {
	[ -f "$WPA_PID" ] && kill -0 "$(cat "$WPA_PID")" 2>/dev/null
}

start() {
	if is_running; then
		echo "$NAME: already running (pid $(cat "$WPA_PID"))"
		return 0
	fi
	# Далі скрізь return 0: відсутність Wi-Fi не повинна зупиняти завантаження (консоль і Ethernet лишаються).
	if ! mount_boot; then
		echo "$NAME: не вдалося змонтувати $BOOT_DEV на $BOOT_DIR" >&2
		return 0
	fi
	# Фоновий підпроцес переживе return з start (init не чекає); лог перезаписується при кожному старті.
	if [ "$(key DEBUG)" != "0" ]; then
		: >"$DEBUG_LOG"
		debug_later &
	fi
	if [ ! -r "$CONF_SRC" ]; then
		echo "$NAME: нема $CONF_SRC, Wi-Fi не вмикаю (створіть файл за зразком wifi.txt.example)" >&2
		return 0
	fi
	if ! make_conf; then
		rm -f "$CONF"
		echo "$NAME: у $CONF_SRC нема жодного рядка SSID=..., Wi-Fi не вмикаю" >&2
		return 0
	fi
	waited=0
	while [ ! -d "/sys/class/net/$IFACE" ] && [ "$waited" -lt "$IFACE_TIMEOUT" ]; do
		sleep 1
		waited=$((waited + 1))
	done
	if [ ! -d "/sys/class/net/$IFACE" ]; then
		echo "$NAME: інтерфейс $IFACE не з'явився за ${IFACE_TIMEOUT} с (перевірте dmesg | grep brcmfmac)" >&2
		return 0
	fi
	# Без -B: у знімку 01.11.2026 wpa_supplicant з -B -s не лишався серед процесів і мовчав. Тепер він працює
	# як звичайний фоновий процес оболонки, а його вивід (-d: налагодження, ключі не друкуються) іде у $WPA_LOG.
	wpa_supplicant -d -D nl80211 -i "$IFACE" -c "$CONF" >"$WPA_LOG" 2>&1 &
	echo $! >"$WPA_PID"
	sleep 1
	if ! is_running; then
		echo "$NAME: wpa_supplicant одразу завершився, див. $WPA_LOG" >&2
	fi
	wifi_power_save_off &
	# -b: якщо адреси ще нема (точка доступу не підключила), лишається у фоні й повторює спроби.
	udhcpc -i "$IFACE" -b -p "$DHCP_PID" -x "hostname:$HOSTNAME_DHCP" -t 3 -T 2 -A 5 -S
	echo "$NAME: started ($IFACE)"
}

stop() {
	for pidfile in "$DHCP_PID" "$WPA_PID"; do
		[ -f "$pidfile" ] && kill "$(cat "$pidfile")" 2>/dev/null
		rm -f "$pidfile"
	done
	rm -f "$CONF"
	echo "$NAME: stopped"
}

status() {
	if is_running; then
		echo "$NAME is running (pid $(cat "$WPA_PID"))"
		ip -4 addr show "$IFACE" 2>/dev/null | sed -n 's/^ *inet /  inet /p'
		return 0
	fi
	echo "$NAME is not running"
	return 3
}

case "$1" in
start) start ;;
stop) stop ;;
restart)
	stop
	start
	;;
status) status ;;
*)
	echo "Usage: $0 {start|stop|restart|status}" >&2
	exit 1
	;;
esac
