BR2_aarch64=y
BR2_cortex_a76=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_AARCH64_GLIBC_STABLE=y
BR2_GLOBAL_PATCH_DIR="board/raspberrypi/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_TARGET_GENERIC_HOSTNAME="motion-logger"
BR2_TARGET_GENERIC_ROOT_PASSWD="motionlogger"
BR2_TARGET_GENERIC_GETTY_PORT="ttyAMA0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_SYSTEM_DHCP="eth0"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_MOTION_LOGGER_PATH)/board/motion_logger/rootfs_overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="board/raspberrypi5/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_MOTION_LOGGER_PATH)/board/motion_logger/post-image.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,21b410140c47ffab5668399f6f143c7d7b935c8b)/linux-21b410140c47ffab5668399f6f143c7d7b935c8b.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcm2712"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="board/raspberrypi/linux-4k-page-size.fragment $(BR2_EXTERNAL_MOTION_LOGGER_PATH)/board/motion_logger/linux.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2712-rpi-5-b broadcom/bcm2712d0-rpi-5-b broadcom/bcm2712-rpi-500"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_MOTION_LOGGER_PATH)/board/motion_logger/busybox.fragment"
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
# Апаратний watchdog BCM2712 (/dev/watchdog): S15watchdog з BusyBox «гладить» його раз на 5 с;
# якщо система зависла, плата перезавантажиться сама приблизно за 15 с.
BR2_PACKAGE_BUSYBOX_WATCHDOG=y
BR2_PACKAGE_XZ=y
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_MOTION_LOGGER_PATH)/board/motion_logger/config.txt"
BR2_PACKAGE_RPI_FIRMWARE_CMDLINE_FILE="$(BR2_EXTERNAL_MOTION_LOGGER_PATH)/board/motion_logger/cmdline.txt"
BR2_PACKAGE_DROPBEAR=y
# Wi-Fi (wlan0 Pi 5, чип CYW43455): прошивка brcmfmac, wpa_supplicant через nl80211, wpa_cli для діагностики,
# regulatory.db (без нього країна UA не застосовується, ядро підписане з CFG80211_REQUIRE_SIGNED_REGDB).
# Мережі й паролі не в rootfs і не в git: файл wifi.txt на розділі boot (docs/wifi.md).
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_BRCM_BCM43XXX=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
# iw: вимкнути енергозбереження wlan0 (brcmfmac вмикає його сам, плата тоді не відповідає на ARP) і читати сигнал
BR2_PACKAGE_IW=y
# Діагностичні утиліти (i2cdetect, gpiodetect, gpioinfo); лише для навчального образу: викладач 22.10.2026 радив
# прибрати їх із продуктового (крок G0 трекера)
BR2_PACKAGE_I2C_TOOLS=y
BR2_PACKAGE_LIBGPIOD=y
BR2_PACKAGE_LIBGPIOD_TOOLS=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="120M"
# BR2_TARGET_ROOTFS_TAR is not set
# U-Boot між прошивкою Pi 5 і ядром (крок 4.7, гілка feature/uboot): збірка rpi_arm64; boot.scr робить post-image.sh з board/motion_logger/boot.cmd
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="rpi_arm64"
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_MOTION_LOGGER_PATH)/board/motion_logger/uboot.fragment"
BR2_TARGET_UBOOT_NEEDS_OPENSSL=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_KMOD_XZ=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_MOTION_LOGGER=y
