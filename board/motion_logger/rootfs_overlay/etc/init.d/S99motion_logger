#!/bin/sh
# Автозапуск motion_logger (BusyBox init викликає S* скрипти з аргументом start / stop).
# Пишемо на POSIX sh: на платі це BusyBox ash, без bash-конструкцій.
# Контракт скрипта (презентація «Init», слайди 26 і 30): start і stop ідемпотентні, код виходу
# 0 = успіх, status повертає 3, якщо служба не працює.
#
# Програму запускає «наглядач» (функція supervise нижче, окремий процес): якщо motion_logger
# завершився з помилкою (датчик зник, порт не відкрився, аварія), наглядач запускає його знову
# через RESTART_DELAY секунд, щоразу вдвічі довше, до RESTART_DELAY_MAX. Успішне завершення
# (код 0: скінченне джерело --replay, порожні параметри) не перезапускається.
# PIDFILE містить PID наглядача, CHILD_PIDFILE PID самої програми.
NAME=motion_logger
DAEMON=/usr/bin/$NAME
PIDFILE=/var/run/$NAME.pid
CHILD_PIDFILE=/var/run/$NAME.child.pid
LOGFILE=/var/log/$NAME.log
# Налагоджувальний порт DBG1 (GPIO14/15). Консоль ядра йде на ttyAMA10 (JST-рознім), а ttyAMA0
# вільний, тож пишемо туди, щоб бачити вивід без JST-кабеля.
DEBUG_TTY=/dev/ttyAMA0
# Скільки секунд чекати завершення після SIGTERM, перш ніж вбити процес через SIGKILL.
STOP_TIMEOUT=5
# Пауза перед перезапуском після аварії: від RESTART_DELAY, подвоюється до RESTART_DELAY_MAX;
# якщо програма перед аварією пропрацювала RESTART_RESET секунд, пауза знову найкоротша.
RESTART_DELAY=2
RESTART_DELAY_MAX=60
RESTART_RESET=60
# Де ядро показує IIO-датчики, і скільки секунд чекати датчик із потрібним ім'ям (драйвер міг
# ще не встигнути з'явитись, коли init дійшов до S99).
IIO_ROOT=/sys/bus/iio/devices
IIO_WAIT=10

# Параметри запуску (джерело відліків, лог) лежать окремо, щоб не правити скрипт:
# /etc/default/motion_logger, змінні MOTION_LOGGER_OPTS і MOTION_LOGGER_IIO_RATES.
# У MOTION_LOGGER_OPTS слово @ім'я (наприклад @mpu6050) скрипт замінює на каталог IIO-датчика з
# таким ім'ям: номер iio:deviceN залежить від порядку підключення драйверів і може змінитись.
MOTION_LOGGER_OPTS=""
MOTION_LOGGER_IIO_RATES=""
[ -r /etc/default/$NAME ] && . /etc/default/$NAME

# Службова функція: 0, якщо процес із PID-файлу $1 (за замовчуванням PIDFILE) живий.
is_running() {
	pidfile=${1:-$PIDFILE}
	[ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null
}

# Наглядач: працює у власному процесі (запускається у фоні), перезапускає програму після аварії.
# SIGTERM передається програмі; поки вона дописує лог, наглядач чекає. Параметри: змінна opts.
supervise() {
	child=
	pause_pid=
	stopping=0
	trap 'stopping=1; [ -n "$child" ] && kill "$child" 2>/dev/null; [ -n "$pause_pid" ] && kill "$pause_pid" 2>/dev/null' TERM INT
	delay=$RESTART_DELAY
	while :; do
		started=$(date +%s)
		# shellcheck disable=SC2086  # параметри з файлу налаштувань мають розбиватись на слова
		"$DAEMON" $opts &
		child=$!
		echo "$child" >"$CHILD_PIDFILE"
		# wait повертається й тоді, коли прийшов сигнал: чекаємо, поки програма справді вийде.
		while :; do
			wait "$child"
			code=$?
			kill -0 "$child" 2>/dev/null || break
		done
		child=
		rm -f "$CHILD_PIDFILE"
		[ "$stopping" -eq 1 ] && break
		[ "$code" -eq 0 ] && break

		[ $(($(date +%s) - started)) -ge "$RESTART_RESET" ] && delay=$RESTART_DELAY
		echo "$NAME: exited with code $code, restarting in ${delay}s"
		sleep "$delay" &
		pause_pid=$!
		wait "$pause_pid"
		pause_pid=
		[ "$stopping" -eq 1 ] && break
		delay=$((delay * 2))
		[ "$delay" -gt "$RESTART_DELAY_MAX" ] && delay=$RESTART_DELAY_MAX
	done
}

# Друкує каталог IIO-датчика з іменем $1 (файл name), чекаючи до IIO_WAIT секунд. Код 1, якщо нема.
find_iio_dir() {
	waited=0
	while :; do
		for dir in "$IIO_ROOT"/iio:device*; do
			if [ -r "$dir/name" ] && [ "$(cat "$dir/name")" = "$1" ]; then
				echo "$dir"
				return 0
			fi
		done
		[ "$waited" -ge "$IIO_WAIT" ] && return 1
		sleep 1
		waited=$((waited + 1))
	done
}

# Друкує параметри $1, замінивши кожне слово @ім'я на каталог датчика з таким іменем.
# Код 1, якщо датчика з ім'ям нема.
resolve_opts() {
	resolved=""
	for word in $1; do
		case "$word" in
		@*)
			dir=$(find_iio_dir "${word#@}") || {
				echo "$NAME: no IIO device named ${word#@}" >&2
				return 1
			}
			word=$dir
			;;
		esac
		resolved="$resolved $word"
	done
	echo "$resolved"
}

# Виставляє частоту самого датчика за списком "ім'я:Гц" (MPU6050 за замовчуванням дає 50 Гц, а
# --iio-rate лише частота опитування). Помилка не зупиняє запуск: датчик працюватиме на своїй частоті.
set_iio_rates() {
	for pair in $MOTION_LOGGER_IIO_RATES; do
		name=${pair%%:*}
		hz=${pair#*:}
		dir=$(find_iio_dir "$name") || {
			echo "$NAME: no IIO device named $name, rate not set" >&2
			continue
		}
		echo "$hz" >"$dir/sampling_frequency" 2>/dev/null ||
			echo "$NAME: cannot set $name to $hz Hz" >&2
	done
}

start() {
	if is_running; then
		echo "$NAME: already running (pid $(cat "$PIDFILE"))"
		return 0
	fi
	rm -f "$PIDFILE" # застарілий PID-файл від аварійного завершення
	# Наглядача вбили (kill -9), а програма лишилась сиротою: не запускаємо другу поруч.
	if is_running "$CHILD_PIDFILE"; then
		kill -9 "$(cat "$CHILD_PIDFILE")" 2>/dev/null
	fi
	rm -f "$CHILD_PIDFILE"

	opts=$(resolve_opts "$MOTION_LOGGER_OPTS") || {
		echo "$NAME: not started" >&2
		return 1
	}
	set_iio_rates

	# Вивід: на DBG1, якщо порт доступний на запис, інакше у файл (слайд 39: логи кудись пишуться).
	if [ -w "$DEBUG_TTY" ]; then
		supervise >"$DEBUG_TTY" 2>&1 &
	else
		supervise >>"$LOGFILE" 2>&1 &
	fi
	echo $! >"$PIDFILE"
	echo "$NAME: started"
}

stop() {
	if ! is_running; then
		rm -f "$PIDFILE"
		echo "$NAME: not running"
		return 0
	fi

	pid=$(cat "$PIDFILE")
	kill "$pid" 2>/dev/null # SIGTERM: наглядач передає його програмі, вона дописує буфер у лог
	waited=0
	while [ "$waited" -lt "$STOP_TIMEOUT" ] && kill -0 "$pid" 2>/dev/null; do
		sleep 1
		waited=$((waited + 1))
	done
	if kill -0 "$pid" 2>/dev/null; then
		echo "$NAME: pid $pid ignored SIGTERM, killing" >&2
		if [ -f "$CHILD_PIDFILE" ]; then
			kill -9 "$(cat "$CHILD_PIDFILE")" 2>/dev/null
		fi
		kill -9 "$pid" 2>/dev/null
	fi
	rm -f "$PIDFILE" "$CHILD_PIDFILE"
	echo "$NAME: stopped"
}

status() {
	if is_running; then
		if is_running "$CHILD_PIDFILE"; then
			echo "$NAME is running (pid $(cat "$CHILD_PIDFILE"), supervisor $(cat "$PIDFILE"))"
		else
			echo "$NAME is restarting (supervisor $(cat "$PIDFILE"))"
		fi
		return 0
	fi
	echo "$NAME is not running"
	return 3
}

case "$1" in
start) start ;;
stop) stop ;;
restart)
	stop
	start
	;;
status) status ;;
*)
	echo "Usage: $0 {start|stop|restart|status}" >&2
	exit 1
	;;
esac
