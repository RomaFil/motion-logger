# Лише LF у скриптах і Makefile: CRLF ламає shebang і Make (презентація 05 Ajax)
* text=auto
*.sh text eol=lf
S99* text eol=lf
Makefile text eol=lf
*.mk text eol=lf
*.c text eol=lf
*.h text eol=lf
*.in text eol=lf
*.csv text eol=lf
*.py text eol=lf
# NMEA як є від модуля: з CRLF у кінці рядків, git їх не чіпає
*.nmea -text
S41* text eol=lf
