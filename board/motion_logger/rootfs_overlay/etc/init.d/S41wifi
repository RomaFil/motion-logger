#!/bin/sh
# Wi-Fi (wlan0) з мережами з розділу boot: /boot/wpa_supplicant.conf. Розділ boot це FAT, тому файл
# правиться на будь-якому комп'ютері через кард-рідер або на платі командою wifi; образ для цього
# перезбирати не треба. Якщо в файлі нема жодного блоку network={...}, Wi-Fi не вмикається зовсім
# (модуль brcmfmac не вантажиться, радіо мовчить).
# Контракт як у S99motion_logger: start і stop ідемпотентні, status повертає 3, якщо служба не працює.
# Лише POSIX sh (BusyBox ash). Стоїть після S40network (eth0) і до S50dropbear.
IFACE=wlan0
# Розділ boot: перший розділ картки (root=/dev/mmcblk0p2 у cmdline.txt)
BOOT_DEV=/dev/mmcblk0p1
BOOT_DIR=/boot
CONF=$BOOT_DIR/wpa_supplicant.conf
WPA_PIDFILE=/var/run/wpa_supplicant.$IFACE.pid
DHCP_PIDFILE=/var/run/udhcpc.$IFACE.pid
# Скільки секунд чекати появи wlan0 після modprobe (драйвер ще вантажить прошивку чипа).
IFACE_TIMEOUT=10
STOP_TIMEOUT=5

# Перевизначення змінних вище (наприклад, інший BOOT_DEV) без правки скрипта.
[ -r /etc/default/wifi ] && . /etc/default/wifi

is_running() {
	[ -f "$1" ] && kill -0 "$(cat "$1")" 2>/dev/null
}

# Розділ boot монтується лише для читання: на запис його на мить перемонтовує команда wifi.
# fmask/dmask: паролі в файлі читає лише root.
mount_boot() {
	grep -q " $BOOT_DIR vfat " /proc/mounts && return 0
	mkdir -p "$BOOT_DIR"
	mount -t vfat -o ro,nodev,nosuid,noexec,fmask=0177,dmask=0077 "$BOOT_DEV" "$BOOT_DIR"
}

has_networks() {
	[ -r "$CONF" ] && grep -q '^[[:space:]]*network[[:space:]]*=' "$CONF"
}

wait_iface() {
	waited=0
	while [ ! -e "/sys/class/net/$IFACE" ]; do
		[ "$waited" -ge "$IFACE_TIMEOUT" ] && return 1
		sleep 1
		waited=$((waited + 1))
	done
}

stop_pid() {
	pidfile=$1
	if is_running "$pidfile"; then
		pid=$(cat "$pidfile")
		kill "$pid" 2>/dev/null
		waited=0
		while [ "$waited" -lt "$STOP_TIMEOUT" ] && kill -0 "$pid" 2>/dev/null; do
			sleep 1
			waited=$((waited + 1))
		done
		kill -9 "$pid" 2>/dev/null
	fi
	rm -f "$pidfile"
}

start() {
	if is_running "$WPA_PIDFILE"; then
		echo "wifi: already running (pid $(cat "$WPA_PIDFILE"))"
		return 0
	fi
	if ! mount_boot; then
		echo "wifi: cannot mount $BOOT_DEV on $BOOT_DIR" >&2
		return 1
	fi
	if ! has_networks; then
		echo "wifi: no networks in $CONF (add one: wifi add <ssid>), not starting"
		return 0
	fi

	# Автопідвантаження модулів (mdev/udev) в образі нема, тому драйвер чипа вантажимо самі.
	modprobe brcmfmac 2>/dev/null
	if ! wait_iface; then
		echo "wifi: $IFACE did not appear (brcmfmac, firmware in /lib/firmware/brcm?)" >&2
		return 1
	fi

	rm -f "$WPA_PIDFILE" "$DHCP_PIDFILE"
	if ! wpa_supplicant -B -i "$IFACE" -D nl80211 -c "$CONF" -P "$WPA_PIDFILE"; then
		echo "wifi: wpa_supplicant failed (syntax of $CONF?)" >&2
		return 1
	fi
	# -b: у фон, якщо адреси одразу нема (мережа ще не знайдена), і далі пробувати там; так
	# старт системи чекає не довше кількох секунд. -R: віддати адресу при зупинці.
	udhcpc -b -R -t 2 -T 2 -A 5 -i "$IFACE" -p "$DHCP_PIDFILE" \
		-x "hostname:$(hostname)" >/dev/null 2>&1
	echo "wifi: started on $IFACE"
}

stop() {
	stop_pid "$DHCP_PIDFILE"
	stop_pid "$WPA_PIDFILE"
	[ -e "/sys/class/net/$IFACE" ] && ifconfig "$IFACE" down 2>/dev/null
	echo "wifi: stopped"
}

status() {
	if is_running "$WPA_PIDFILE"; then
		echo "wifi: running (pid $(cat "$WPA_PIDFILE"))"
		wpa_cli -i "$IFACE" status 2>/dev/null | grep -E '^(ssid|wpa_state|ip_address)='
		return 0
	fi
	echo "wifi: not running"
	return 3
}

case "$1" in
start) start ;;
stop) stop ;;
restart | reload)
	stop
	start
	;;
status) status ;;
*)
	echo "Usage: $0 {start|stop|restart|status}" >&2
	exit 1
	;;
esac
