# Лише LF у скриптах і Makefile: CRLF ламає shebang і Make (презентація 05 Ajax)
* text=auto
*.sh text eol=lf
S[0-9][0-9]* text eol=lf
board/motion_logger/rootfs_overlay/usr/sbin/* text eol=lf
Makefile text eol=lf
*.mk text eol=lf
*.c text eol=lf
*.h text eol=lf
*.in text eol=lf
*.csv text eol=lf
*.py text eol=lf
# NMEA як є від модуля: з CRLF у кінці рядків, git їх не чіпає
*.nmea -text
