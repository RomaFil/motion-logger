# Wi-Fi для власного образу Motion Logger. Зразок: справжній файл НЕ комітимо (він у .gitignore).
#
# Куди класти: файл з іменем wifi.txt у корінь розділу boot на microSD (у Windows це диск з
# config.txt і cmdline.txt). Образ читає його під час завантаження (скрипт /etc/init.d/S41wifi).
# Змінили мережу: відредагували файл (на картці або `vi /boot/wifi.txt` на платі), потім
# `/etc/init.d/S41wifi restart` або перезавантаження.
#
# Формат: одна пара КЛЮЧ=значення на рядок, без лапок і пробілів навколо "=". У паролі не можна
# символи " і \ . Пароль WPA2: 8-63 символи. WPA3 у образі не ввімкнено (зміша WPA2/WPA3 працює).

# Країна для регуляторних обмежень каналів (за замовчуванням UA)
COUNTRY=UA

# Основна мережа (дім)
SSID=назва_мережі
PSK=пароль_мережі

# Запасні мережі, необов'язково (до трьох): наприклад, точка доступу телефону для показу викладачу.
# wpa_supplicant сам підключається до тієї, що доступна. Порожній PSK = відкрита мережа.
#SSID2=hotspot_телефону
#PSK2=пароль_hotspot
#SSID3=
#PSK3=
#SSID4=
#PSK4=

# Діагностичний лог /boot/wifi-debug.log за замовчуванням увімкнено; вимкнути:
#DEBUG=0
